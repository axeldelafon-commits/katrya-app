# ==============================================================================
# KATRYA - Variables d'environnement
# Copiez ce fichier en .env.local pour le developpement local
# IMPORTANT : ne jamais committer .env.local dans Git
#
# Les noms ci-dessous sont ceux reellement lus par le code (lib/nft.ts,
# lib/supabase/*, app/api/**). Toute variable absente d'ici n'est pas utilisee.
# ==============================================================================

# ------------------------------------------------------------------------------
# Supabase (obligatoire)
# Dashboard Supabase -> Project -> Settings -> API
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# ------------------------------------------------------------------------------
# URL publique de l'app (liens resolver NFC, external_url des metadonnees NFT)
# ------------------------------------------------------------------------------
APP_BASE_URL=https://katrya-app.vercel.app
NEXT_PUBLIC_APP_URL=https://katrya-app.vercel.app

# ------------------------------------------------------------------------------
# Blockchain / NFT - ethers.js v6 + Alchemy, sur Polygon Mainnet (chainId 137)
# ------------------------------------------------------------------------------

# URL RPC complete fournie par Alchemy (https://alchemy.com, gratuit)
# Format : https://polygon-mainnet.g.alchemy.com/v2/VOTRE_CLE
ALCHEMY_POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/xxxxxxxx

# Cle privee du wallet admin KATRYA : proprietaire du contrat, signe les mints.
# Format : 0x + 64 caracteres hexadecimaux, SANS espace ni retour a la ligne.
# SECURITE : ne jamais exposer cette valeur, ne jamais la committer.
KATRYA_WALLET_PRIVATE_KEY=0x...

# Adresse publique du meme wallet (destinataire par defaut au mint).
# Doit correspondre a la cle ci-dessus : /api/nft/status renvoie
# envWalletMatchesKey pour le verifier.
KATRYA_ADMIN_WALLET_ADDRESS=0x...

# Adresse du contrat ERC-721 KatryaNFT deploye sur Polygon Mainnet
NFT_CONTRACT_ADDRESS=0x...

# ==============================================================================
# Verification
