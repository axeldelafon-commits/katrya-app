# ==============================================================================
# KATRYA – Variables d'environnement
# Copiez ce fichier en .env.local pour le développement local
# IMPORTANT : Ne jamais committer .env.local dans Git
# ==============================================================================

# ------------------------------------------------------------------------------
# Supabase (obligatoire)
# Disponible sur https://supabase.com/dashboard -> Project -> API
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# ------------------------------------------------------------------------------
# Blockchain / NFT - Stack GRATUIT (ethers.js + Alchemy)
# ------------------------------------------------------------------------------

# --- Alchemy (gratuit sur https://alchemy.com) ---
# 1. Créer un compte sur https://alchemy.com (gratuit)
# 2. Créer une App -> Network: Polygon Mumbai (test) ou Polygon Mainnet
# 3. Copier la clé API ci-dessous
ALCHEMY_API_KEY=votre_alchemy_api_key_ici

# Réseau Polygon: mainnet (production) ou mumbai (test)
POLYGON_NETWORK=mumbai

# --- Smart Contract NFT ---
# Adresse du contrat déployé (obtenue après exécution de scripts/deploy-contract.ts)
# Laisser vide jusqu'au déploiement du contrat
KATRYA_NFT_CONTRACT_ADDRESS=0x21fE295A01907b1e2C513BA64dB82Cc816dAad8C
# --- Wallet Admin KATRYA ---
# Clé privée du wallet qui détient les NFTs et fait les mint/transfer
# SECURITE: Ne JAMAIS exposer cette clé publiquement
# Générer un wallet sur https://metamask.io ou https://rabby.io
KATRYA_ADMIN_PRIVATE_KEY=0x...

# Adresse publique du wallet admin (utilisée comme destinataire par défaut au mint)
KATRYA_ADMIN_WALLET_ADDRESS=0x...

# --- Polygonscan API (optionnel - pour vérifier les contrats) ---
# Disponible sur https://polygonscan.com/register
POLYGONSCAN_API_KEY=votre_polygonscan_api_key_optionnel

# ==============================================================================
# RAPPEL : Pour démarrer la dimension blockchain KATRYA NFT
# ==============================================================================
# 1. Créer un compte Alchemy gratuit -> https://alchemy.com
# 2. Créer un wallet MetaMask -> https://metamask.io
# 3. Obtenir des MATIC de test -> https://faucet.polygon.technology/
# 4. Déployer le contrat: npx ts-node scripts/deploy-contract.ts
# 5. Remplir KATRYA_NFT_CONTRACT_ADDRESS avec l'adresse obtenue
# 6. Lancer la migration SQL: supabase/migrations/20260505_nft_blockchain.sql
# ==============================================================================
