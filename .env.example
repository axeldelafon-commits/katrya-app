# ==============================================================================
# KATRYA — Variables d'environnement
# Copiez ce fichier en .env.local pour le développement local
# IMPORTANT : Ne jamais committer .env.local dans Git
# ==============================================================================

# ------------------------------------------------------------------------------
# Supabase (obligatoire)
# Disponible sur https://supabase.com/dashboard -> Project -> API
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# Thirdweb (nécessaire pour les fonctionnalités NFT/Blockchain)
# Étape 1 : Créer un compte sur https://thirdweb.com
# Étape 2 : API Keys -> Créer une clé -> copier la Secret Key
# ------------------------------------------------------------------------------
THIRDWEB_SECRET_KEY=your_thirdweb_secret_key_here

# ------------------------------------------------------------------------------
# Smart Contract NFT (nécessaire pour les fonctionnalités NFT/Blockchain)
# Étape 1 : Thirdweb Dashboard -> Explore -> NFT Collection
# Étape 2 : Deploy sur Polygon Mainnet (chain ID 137)
# Étape 3 : Copier l'adresse du contrat ici
# Exemple  : 0x1234567890abcdef1234567890abcdef12345678
# ------------------------------------------------------------------------------
THIRDWEB_CONTRACT_ADDRESS=0x_your_deployed_contract_address_on_polygon

# ------------------------------------------------------------------------------
# Wallet Admin KATRYA (nécessaire pour les fonctionnalités NFT/Blockchain)
# Ce wallet signe les transactions de mint et de transfert NFT.
# Étape 1 : Créer un wallet MetaMask dédié KATRYA (ne pas utiliser un wallet personnel)
# Étape 2 : Exporter la private key (MetaMask -> Account Details -> Export private key)
# Étape 3 : Alimenter ce wallet avec ~2 MATIC pour les frais de gas
#            (Acheter du MATIC sur Binance/Coinbase, envoyer vers ce wallet)
# Étape 4 : Coller la private key ici (JAMAIS partager cette clé avec qui que ce soit)
# SECURITE : Cette variable ne doit JAMAIS être exposée côté client
#            Elle n'est utilisée que dans les API routes Next.js (server-side)
# ------------------------------------------------------------------------------
KATRYA_ADMIN_PRIVATE_KEY=0x_your_admin_wallet_private_key_here

# ------------------------------------------------------------------------------
# Optionnel : URL de base de l'application
# Utilisé pour générer les QR codes et les liens de certificats
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://katrya-app.vercel.app
